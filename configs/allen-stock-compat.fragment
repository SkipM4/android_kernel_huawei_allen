# The OEM PGO data and private signing tools are not in this source release.
# CONFIG_KERNEL_CODEMERGE is not set
# Its implementation is absent; standard enforcing CFI remains enabled.
# CONFIG_HKIP_CFI_HARDEN is not set
# Full LTO exhausted host memory; ThinLTO retains standard cross-module CFI.
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_LTO_CLANG_THIN=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_SYSTEM_TRUSTED_KEYS="certs/allen-stock-module-signing.pem"
# Match the stock kernel rather than enabling this from a nonempty tool prefix.
# CONFIG_COMPAT_VDSO is not set
# Retain pre-ADB boot warnings during the current diagnostic iterations.
CONFIG_LOG_BUF_SHIFT=23
# Restore the ioctl dispatcher and its DT-aware thermal query provider.
CONFIG_PERF_CTRL=y
# Restore the original frame feature closure as a separate candidate.
CONFIG_FRAME_RTG=y
CONFIG_HW_RTG_SCHED=y
CONFIG_HW_RTG_CONSTRAINT=y
CONFIG_HW_RTG_MULTI_FRAME=y
CONFIG_HW_RTG_VIP_FOR_MULTI_FRAME=y
# CONFIG_SCHED_STAT_YIELD is not set
# Keep the hardware-specific DDR provider outside this interface step.
# CONFIG_DDR_PERF_CTRL is not set
